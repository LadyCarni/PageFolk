datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(cuid())
  googleId        String   @unique
  email           String   @unique
  name            String?
  avatarUrl       String?
  lastSeenVersion String?
  createdAt       DateTime @default(now())

  memberships ThreadMembership[]
  posts       Post[]
  progress    ReadingProgress[]
  reactions   PostReaction[]

  roadmapItems   RoadmapItem[]  @relation("RoadmapAuthor")
  roadmapVotes   RoadmapVote[]
  roadmapEntries RoadmapEntry[]
}

model AllowedEmail {
  email   String   @id
  addedAt DateTime @default(now())
}

// Someone who signed in with Google but isn't on the allowed list yet.
model AccessRequest {
  email       String   @id
  name        String?
  avatarUrl   String?
  requestedAt DateTime @default(now())
}

model Book {
  id        String   @id @default(cuid())
  title     String
  author    String
  coverUrl  String?
  status    String   @default("current")
  createdAt DateTime @default(now())

  totalChapters Int
  blurb         String?
  readMonth     String? // "YYYY-MM", the month the club read the book
  genre         String? // one of GENRES in src/lib/genres.ts

  sections Section[]
  cover    BookCover?
  progress ReadingProgress[]

  chapterNames ChapterName[]
}

model ChapterName {
  bookId String
  number Int // 1-based chapter number
  name   String

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([bookId, number])
}

model BookCover {
  bookId      String   @id
  data        Bytes
  contentType String
  updatedAt   DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id])
}

model Section {
  id           String   @id @default(cuid())
  bookId       String
  startChapter Int
  endChapter   Int
  title        String?
  order        Int
  createdAt    DateTime @default(now())

  book        Book               @relation(fields: [bookId], references: [id])
  memberships ThreadMembership[]
  posts       Post[]

  @@unique([bookId, order])
}

model ThreadMembership {
  userId    String
  sectionId String
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@id([userId, sectionId])
}

model Post {
  id           String   @id @default(cuid())
  sectionId    String
  userId       String
  body         String
  parentPostId String?
  createdAt    DateTime @default(now())

  section    Section @relation(fields: [sectionId], references: [id])
  user       User    @relation(fields: [userId], references: [id])
  parentPost Post?   @relation("Replies", fields: [parentPostId], references: [id])
  replies    Post[]  @relation("Replies")
  reactions  PostReaction[]
}

// One member's reaction to a post. The key makes each kind count once per person; removing the row undoes it.
model PostReaction {
  postId    String
  userId    String
  kind      String // one of REACTIONS in src/lib/reactions.ts
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, kind])
}

model ReadingProgress {
  userId           String
  bookId           String
  chaptersFinished Int      @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@id([userId, bookId])
}

model Club {
  id   Int    @id @default(1)
  name String
}

model RoadmapItem {
  id                  String   @id @default(cuid())
  number              Int?     @unique // assigned on approval or admin create
  title               String // public wording
  description         String
  originalTitle       String // as first written; shown at the top of the thread
  originalDescription String
  status              String // 'review' | 'planned' | 'in_progress' | 'not_planned'
  isMemberRequest     Boolean
  authorId            String
  createdAt           DateTime @default(now())

  author  User           @relation("RoadmapAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  votes   RoadmapVote[]
  entries RoadmapEntry[]
}

model RoadmapVote {
  itemId String
  userId String

  item RoadmapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
}

model RoadmapEntry {
  id        String   @id @default(cuid())
  itemId    String
  authorId  String
  kind      String // 'reply' | 'event'
  body      String // reply text, or event code: 'approved' | 'planned' | 'in_progress' | 'not_planned'
  createdAt DateTime @default(now())

  item   RoadmapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
